{
  "name": "@ducat-unit/wallet-snap",
  "version": "0.2.3",
  "description": "Ducat Bitcoin account and signing Snap for MetaMask.",
  "keywords": [
    "ducat",
    "metamask-snap",
    "bitcoin",
    "mainnet",
    "signet",
    "mutinynet",
    "psbt"
  ],
  "homepage": "https://github.com/DUCAT-UNIT/ducat-snap#readme",
  "bugs": {
    "url": "https://github.com/DUCAT-UNIT/ducat-snap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DUCAT-UNIT/ducat-snap.git"
  },
  "license": "MIT",
  "main": "./dist/bundle.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "images/",
    "snap.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "mm-snap build",
    "manifest": "mm-snap manifest",
    "serve": "mm-snap serve",
    "start": "mm-snap watch",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm test && npm run build && npm run manifest",
    "lint": "npm run type-check && npm test",
    "audit:prod": "npm audit --omit=dev",
    "harness:accounts": "node scripts/snap-simulation-harness.mjs accounts",
    "harness:smoke-signing": "node scripts/snap-simulation-harness.mjs smoke-signing",
    "harness:session": "node scripts/snap-simulation-harness.mjs session",
    "harness:bitvm3-reclaim": "node scripts/snap-simulation-harness.mjs bitvm3-reclaim",
    "harness:bitvm3-reclaim-reject": "node scripts/snap-simulation-harness.mjs bitvm3-reclaim-reject",
    "verify:bitvm3": "npm run harness:bitvm3-reclaim && npm run harness:bitvm3-reclaim-reject",
    "verify:harness": "npm run harness:accounts && npm run harness:smoke-signing && npm run verify:bitvm3",
    "verify:release": "bash scripts/verify-release.sh",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run verify:release"
  },
  "dependencies": {
    "@bitcoin-js/tiny-secp256k1-asmjs": "2.2.4",
    "@noble/hashes": "1.8.0",
    "bitcoinjs-lib": "6.1.7",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@metamask/snaps-cli": "8.4.1",
    "@metamask/snaps-sdk": "11.1.1",
    "@metamask/snaps-simulation": "4.2.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.21",
    "jest": "29.7.0",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
